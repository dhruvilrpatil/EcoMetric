# ─────────────────────────────────────────────────────────────
# EcoMetric Frontend — Environment Variables Template
# Copy this file to .env to configure local frontend settings.
# Default values will run the frontend out-of-the-box in mock dev mode.
# ─────────────────────────────────────────────────────────────

# ── Backend API URL ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# ── Firebase Authentication (Optional in Dev Mode) ───────────
# In dev mode, a mock user session is automatically used so you can
# preview and build the UI without setting up a live Firebase account.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your-app-id
